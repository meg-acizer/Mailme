# ==============================================================================
# WORVANTA — ENTERPRISE WORKSPACE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Supabase (Multi-Tenant Database, Auth & Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Bóveda de Cifrado AES-256-GCM (32 bytes en hexadecimal = 64 caracteres)
# Se utiliza para cifrar API Keys de LLM, Tokens de Telegram y credenciales IMAP/SMTP/OAuth
# Para rotar claves sin romper datos existentes: subí ENCRYPTION_KEY_VERSION=v2 y definí ENCRYPTION_MASTER_KEY_V2
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# ENCRYPTION_MASTER_KEY_V2=

# 3. URL Pública de la Aplicación (Para Webhooks de Telegram y OAuth Redirects)
NEXT_PUBLIC_APP_URL=https://worvanta.tu-dominio.com
# Secreto obligatorio en producción para validar el header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=cambia-este-secreto-largo-aleatorio

# 4. Demonio Antivirus ClamAV (Opcional — si se omite, usa el motor embebido de firmas y heurística)
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# 5. Claves LLM por Defecto de Respaldo (Opcional — cada Tenant configura las suyas en la consola Admin)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# 6. OAuth 2.0 Proveedores (Microsoft 365 Correo/Calendario y Google Calendar sin CASA)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
